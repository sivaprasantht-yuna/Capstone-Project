# ─── Production Environment (Netlify) ─────────────────────────────────────────
# Set these in the Netlify Dashboard → Site > Environment Variables
# These are build-time variables that get baked into the Vite bundle.

# Backend API base URL (no trailing slash)
# Example: https://your-backend.onrender.com/api/v1
VITE_API_URL=

# WebSocket URL (no trailing slash)
# Example: wss://your-backend.onrender.com/ws
VITE_WS_URL=
